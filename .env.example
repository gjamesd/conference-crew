# Elastic Cloud Serverless — create an Elasticsearch project type trial
# https://cloud.elastic.co/registration
ELASTICSEARCH_URL=https://your-project.es.us-central1.gcp.elastic.cloud
ELASTICSEARCH_API_KEY=your_api_key_here

# OpenAI — claim team hackathon credits, then create an API key (never commit the key)
# Use gpt-4o-mini for cost efficiency; Elasticsearch does retrieval, OpenAI only narrates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Linear — personal API key (never commit). Run: python scripts/setup_linear.py
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_TEAM_KEY=

# App
DEFAULT_GROUP_ID=crew-demo
HOST=0.0.0.0
PORT=8000
